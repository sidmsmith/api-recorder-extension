{
  "manifest_version": 3,
  "key": "",
  "name": "API Recorder",
  "version": "0.4.3",
  "description": "One click to record a tab's API calls (like DevTools' Network panel), one click to stop and download a HAR file.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "API Recorder: click to start recording this tab's API calls",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Start or stop recording (in scenario mode: opens the scenario panel to start)"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["keyguard.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["debugger", "downloads", "storage", "tabs", "webNavigation", "management"]
}
